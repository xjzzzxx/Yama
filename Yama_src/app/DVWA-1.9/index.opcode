         32*       <  8> CONCAT                                            RES[  IS_TMP_VAR ~16 ]      OP1[  IS_CONST (268435349) '%0D%0A%3Cdiv+class%3D%22body_padded%22%3E%0D%0A%09%3Ch1%3EWelcome+to+Damn+Vulnerable+Web+Application%21%3C%2Fh1%3E%0D%0A%09%3Cp%3EDamn+Vulnerable+Web+Application+%28DVWA%29+is+a+PHP%2FMySQL+web+application+that+is+damn+vulnerable.+Its+main+goal+is+to+be+an+aid+for+security+professionals+to+test+their+skills+and+tools+in+a+legal+environment%2C+help+web+developers+better+understand+the+processes+of+securing+web+applications+and+to+aid+both+students+%26+teachers+to+learn+about+web+application+security+in+a+controlled+class+room+environment.%3C%2Fp%3E%0D%0A%09%3Cp%3EThe+aim+of+DVWA+is+to+%3Cem%3Epractice+some+of+the+most+common+web+vulnerability%3C%2Fem%3E%2C+with+%3Cem%3Evarious+difficultly+levels%3C%2Fem%3E%2C+with+a+simple+straightforward+interface.%3C%2Fp%3E%0D%0A%09%3Chr+%2F%3E%0D%0A%09%3Cbr+%2F%3E%0D%0A%0D%0A%09%3Ch2%3EGeneral+Instructions%3C%2Fh2%3E%0D%0A%09%3Cp%3EIt+is+up+to+the+user+how+they+approach+DVWA.+Either+by+working+through+every+module+at+a+fixed+level%2C+or+selecting+any+module+and+working+up+to+reach+the+highest+level+they+can+before+moving+onto+the+next+one.+There+is+not+a+fixed+object+to+complete+a+module%3B+however+users+should+feel+that+they+have+successfully+exploited+the+system+as+best+as+they+possible+could+by+using+that+particular+vulnerability.%3C%2Fp%3E%0D%0A%09%3Cp%3EPlease+note%2C+there+are+%3Cem%3Eboth+documented+and+undocumented+vulnerability%3C%2Fem%3E+with+this+software.+This+is+intentional.+You+are+encouraged+to+try+and+discover+as+many+issues+as+possible.%3C%2Fp%3E%0D%0A%09%3Cp%3EDVWA+also+includes+a+Web+Application+Firewall+%28WAF%29%2C+PHPIDS%2C+which+can+be+enabled+at+any+stage+to+further+increase+the+difficulty.+This+will+demonstrate+how+adding+another+layer+of+security+may+block+certain+malicious+actions.+Note%2C+there+are+also+various+public+methods+at+bypassing+these+protections+%28so+this+can+be+see+an+as+extension+for+more+advance+users%29%21%3C%2Fp%3E%0D%0A%09%3Cp%3EThere+is+a+help+button+at+the+bottom+of+each+page%2C+which+allows+you+to+view+hints+%26+tips+for+that+vulnerability.+There+are+also+additional+links+for+further+background+reading%2C+which+relates+to+that+security+issue.%3C%2Fp%3E%0D%0A%09%3Chr+%2F%3E%0D%0A%09%3Cbr+%2F%3E%0D%0A%0D%0A%09%3Ch2%3EWARNING%21%3C%2Fh2%3E%0D%0A%09%3Cp%3EDamn+Vulnerable+Web+Application+is+damn+vulnerable%21+%3Cem%3EDo+not+upload+it+to+your+hosting+provider%27s+public+html+folder+or+any+Internet+facing+servers%3C%2Fem%3E%2C+as+they+will+be+compromised.+It+is+recommend+using+a+virtual+machine+%28such+as+' ] OP2[ ,  IS_VAR $15 ]
